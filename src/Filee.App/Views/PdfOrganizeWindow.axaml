<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.PdfOrganizeWindow"
        x:DataType="vm:PdfOrganizeViewModel"
        Title="Organise PDF Pages"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="960" Height="680" MinWidth="780" MinHeight="540"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.tool-btn">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tool-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.card-action">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource SoftRadius}"
          Background="{DynamicResource GlassPanelBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="{DynamicResource GlassShadow}">
    <DockPanel>
      <!-- Top header bar -->
      <Border DockPanel.Dock="Top" Height="50" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close" Margin="4,0,0,0">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Width="30" Height="30">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.FilePdf}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Organise PDF Pages" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" />
            </Border>

            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding HasPages}">
              <TextBlock Text="{Binding CurrentPageCount, StringFormat='{}{0} pages'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Subheader action toolbar -->
      <Border DockPanel.Dock="Top" Padding="18,8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="tool-btn" Command="{Binding RotateAllClockwiseCommand}" ToolTip.Tip="Rotate all pages 90° clockwise">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.RotateCw}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Rotate All CW" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="tool-btn" Command="{Binding ResetOrderCommand}" ToolTip.Tip="Reset to original PDF page order">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Refresh}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Reset Order" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Text="Reorder pages using &lt; and &gt;, rotate using ⟳, or remove unwanted pages."
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="tool-btn" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="tool-btn" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" Padding="16,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsSaving}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsSaving}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Save Organised PDF" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Center grid of page thumbnail cards -->
      <Grid Margin="18,14">
        <!-- Loading state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsLoading}">
          <ProgressBar IsIndeterminate="True" Width="180" Height="4" HorizontalAlignment="Center" />
          <TextBlock Text="Generating page previews..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Pages ItemsControl -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasPages}">
          <ItemsControl ItemsSource="{Binding Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfPageItemViewModel">
                <Border Margin="8" Width="170" CornerRadius="10"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                  <DockPanel>
                    <!-- Top card toolbar: Page badge, Move Left, Move Right, Rotate, Delete -->
                    <Border DockPanel.Dock="Top" Height="34" Padding="8,0" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                      <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).MoveLeftCommand}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding !IsFirst}" ToolTip.Tip="Move Left">
                            <PathIcon Width="9" Height="9" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource TextPrimaryBrush}">
                              <PathIcon.RenderTransform>
                                <RotateTransform Angle="180" />
                              </PathIcon.RenderTransform>
                            </PathIcon>
                          </Button>
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).MoveRightCommand}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" ToolTip.Tip="Move Right">
                            <PathIcon Width="9" Height="9" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource TextPrimaryBrush}" />
                          </Button>
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).RotateClockwiseCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Rotate 90° CW">
                            <PathIcon Width="11" Height="11" Data="{StaticResource Icon.RotateCw}" Foreground="{DynamicResource TextPrimaryBrush}" />
                          </Button>
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).DeletePageCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Remove Page">
                            <PathIcon Width="9" Height="9" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Button>
                        </StackPanel>

                        <!-- Page number -->
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayPageNumber, StringFormat='{}P. {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                      </DockPanel>
                    </Border>

                    <!-- Page Thumbnail Preview -->
                    <Border Height="210" Background="{DynamicResource SurfaceBrush}" Padding="8">
                      <Grid>
                        <!-- Shimmer / placeholder if thumbnail not loaded yet -->
                        <PathIcon Width="24" Height="24" Data="{StaticResource Icon.FilePdf}" Foreground="{DynamicResource SubtleBorderBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />

                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="MediumQuality"
                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Image.RenderTransform>
                            <RotateTransform Angle="{Binding RotationDegrees}" />
                          </Image.RenderTransform>
                        </Image>
                      </Grid>
                    </Border>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
