<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.PdfOrganizeWindow"
        x:DataType="vm:PdfOrganizeViewModel"
        Title="Organise PDF Pages"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="960" Height="680" MinWidth="780" MinHeight="540"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.card-action">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource DialogRadius}"
          Background="{DynamicResource GlassCardBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="0 24 64 0 #50000000, 0 2 0 0 #40FFFFFF inset">
    <DockPanel>
      <!-- Top header bar matching Tangerine modal standard -->
      <Border DockPanel.Dock="Top" Height="56" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
          <!-- Left: Circular close button -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
          </Button>

          <!-- Center: Bold window title -->
          <TextBlock Grid.Column="1" Text="Organise PDF Pages" FontWeight="Bold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Right: Badges -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" />
            </Border>

            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding HasPages}">
              <TextBlock Text="{Binding CurrentPageCount, StringFormat='{}{0} pages'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Subheader action toolbar -->
      <Border DockPanel.Dock="Top" Padding="18,10" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="reset" Command="{Binding RotateAllClockwiseCommand}" ToolTip.Tip="Rotate all pages 90° clockwise">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.RotateCw}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Rotate All CW" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="reset" Command="{Binding ResetOrderCommand}" ToolTip.Tip="Reset to original PDF page order">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Refresh}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Reset Order" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Text="Reorder pages using &lt; and &gt;, rotate using ⟳, or remove unwanted pages."
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="reset" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="apply" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsSaving}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsSaving}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Save Organised PDF" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Center grid of page thumbnail cards -->
      <Grid Margin="20,16">
        <!-- Loading state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsLoading}">
          <ProgressBar IsIndeterminate="True" Width="180" Height="4" HorizontalAlignment="Center" />
          <TextBlock Text="Generating page previews..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Pages ItemsControl -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasPages}">
          <ItemsControl ItemsSource="{Binding Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfPageItemViewModel">
                <Border Margin="8" Width="170" CornerRadius="12"
                        Classes="glass-card"
                        ClipToBounds="True">
                  <DockPanel>
                    <!-- Top card toolbar: Page badge, Move Left, Move Right, Rotate, Delete -->
                    <Border DockPanel.Dock="Top" Height="36" Padding="8,0" Background="{DynamicResource GlassPanelBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1">
                      <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).MoveLeftCommand}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding !IsFirst}" ToolTip.Tip="Move Left">
                            <PathIcon Width="9" Height="9" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource TextPrimaryBrush}">
                              <PathIcon.RenderTransform>
                                <RotateTransform Angle="180" />
                              </PathIcon.RenderTransform>
                            </PathIcon>
                          </Button>
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).MoveRightCommand}"
                                  CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" ToolTip.Tip="Move Right">
                            <PathIcon Width="9" Height="9" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource TextPrimaryBrush}" />
                          </Button>
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).RotateClockwiseCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Rotate 90° CW">
                            <PathIcon Width="11" Height="11" Data="{StaticResource Icon.RotateCw}" Foreground="{DynamicResource TextPrimaryBrush}" />
                          </Button>
                          <Button Classes="card-action" Command="{Binding $parent[Window].((vm:PdfOrganizeViewModel)DataContext).DeletePageCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Remove Page">
                            <PathIcon Width="9" Height="9" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Button>
                        </StackPanel>

                        <!-- Page number -->
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayPageNumber, StringFormat='{}P. {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                      </DockPanel>
                    </Border>

                    <!-- Page Thumbnail Preview -->
                    <Border Height="210" Background="#111116" Padding="8">
                      <Grid>
                        <!-- Placeholder -->
                        <PathIcon Width="24" Height="24" Data="{StaticResource Icon.FilePdf}" Foreground="{DynamicResource GlassBorderBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />

                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="MediumQuality"
                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Image.RenderTransform>
                            <RotateTransform Angle="{Binding RotationDegrees}" />
                          </Image.RenderTransform>
                        </Image>
                      </Grid>
                    </Border>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
