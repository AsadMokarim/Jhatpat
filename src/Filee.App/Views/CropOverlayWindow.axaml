<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        xmlns:c="using:Filee.App.Controls"
        x:Class="Filee.App.Views.CropOverlayWindow"
        x:DataType="vm:CropOverlayViewModel"
        Title="Crop Image"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="920" Height="740" MinWidth="720" MinHeight="560"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" />
  </Window.KeyBindings>

  <!-- Tangerine frosted glass window shell with 24px corner radius -->
  <Border Margin="16" CornerRadius="{DynamicResource SoftRadiusLarge}"
          Background="{DynamicResource GlassBackdropBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="{DynamicResource GlassShadow}">
    <DockPanel>
      <!-- Top header bar: circular close button on left, centered bold title -->
      <Border DockPanel.Dock="Top" Height="52" Padding="18,0"
              BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <!-- Top-left circular close button matching reference design -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CancelCommand}"
                  ToolTip.Tip="{DynamicResource common.close}">
            <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Close}"
                      Foreground="{DynamicResource TextPrimaryBrush}" />
          </Button>

          <!-- Centered bold window title -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Crop Image" FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="—" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsEditing}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentFileName}" IsVisible="{Binding IsEditing}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
            <Border IsVisible="{Binding HasMultipleFiles}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
              <TextBlock Text="{Binding CounterText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </StackPanel>

          <!-- Top-right status or balance placeholder -->
          <Border Grid.Column="2" IsVisible="{Binding HasStatusNotice}" Background="{DynamicResource GlassCardBrush}"
                  BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3">
            <TextBlock Text="{Binding StatusNotice}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxWidth="240" />
          </Border>
        </Grid>
      </Border>

      <!-- Bottom toolbar: Aspect ratio pills, W/H pixel inputs, Reset and Apply buttons -->
      <Border DockPanel.Dock="Bottom" Padding="20,16" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <StackPanel Spacing="14">
          <!-- Row 1: Aspect Ratio segmented pill group -->
          <DockPanel IsVisible="{Binding IsEditing}">
            <TextBlock DockPanel.Dock="Left" Text="Aspect ratio" FontWeight="Medium" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

            <!-- Dimension readouts on the right -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="W" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <Border Background="{DynamicResource GlassInputBrush}" BorderBrush="{DynamicResource GlassInputBorderBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="12,4" MinWidth="68">
                <TextBlock Text="{Binding CropPixelWidth}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
              </Border>

              <TextBlock Text="H" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
              <Border Background="{DynamicResource GlassInputBrush}" BorderBrush="{DynamicResource GlassInputBorderBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="12,4" MinWidth="68">
                <TextBlock Text="{Binding CropPixelHeight}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="px" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
            </StackPanel>

            <!-- Segmented pill switcher -->
            <Border Classes="pill-group" HorizontalAlignment="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="1">
                <Button Classes="pill" Classes.active="{Binding IsAspectFree}" Content="Free"
                        Command="{Binding SetAspectCommand}" CommandParameter="free" />
                <Rectangle Classes="pill-divider" />
                <Button Classes="pill" Classes.active="{Binding IsAspectSquare}" Content="1:1"
                        Command="{Binding SetAspectCommand}" CommandParameter="1:1" />
                <Rectangle Classes="pill-divider" />
                <Button Classes="pill" Classes.active="{Binding IsAspect169}" Content="16:9"
                        Command="{Binding SetAspectCommand}" CommandParameter="16:9" />
                <Rectangle Classes="pill-divider" />
                <Button Classes="pill" Classes.active="{Binding IsAspect916}" Content="9:16"
                        Command="{Binding SetAspectCommand}" CommandParameter="9:16" />
                <Rectangle Classes="pill-divider" />
                <Button Classes="pill" Classes.active="{Binding IsAspect43}" Content="4:3"
                        Command="{Binding SetAspectCommand}" CommandParameter="4:3" />
                <Rectangle Classes="pill-divider" />
                <Button Classes="pill" Classes.active="{Binding IsAspect34}" Content="3:4"
                        Command="{Binding SetAspectCommand}" CommandParameter="3:4" />
                <Rectangle Classes="pill-divider" />
                <Button Classes="pill" Classes.active="{Binding IsAspectOriginal}" Content="Original"
                        Command="{Binding SetAspectCommand}" CommandParameter="original" />
              </StackPanel>
            </Border>
          </DockPanel>

          <!-- Row 2: Action buttons (Reset on left, Apply on right) -->
          <DockPanel>
            <!-- Reset button on left -->
            <Button DockPanel.Dock="Left" Classes="reset" Content="Reset" Command="{Binding ResetCommand}"
                    IsVisible="{Binding IsEditing}" />

            <!-- Primary and secondary actions on right -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="reset" Content="Skip" Command="{Binding SkipCommand}"
                      IsVisible="{Binding HasMultipleFiles}" />
              <Button Classes="reset" Command="{Binding CopyToClipboardCommand}" IsVisible="{Binding IsEditing}"
                      ToolTip.Tip="{DynamicResource clipboard.copy_image}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Copy}" />
                  <TextBlock Text="{DynamicResource clipboard.copy_image}" />
                </StackPanel>
              </Button>
              <Button Classes="apply" Content="Apply" Command="{Binding CropAndSaveCommand}"
                      IsDefault="{Binding IsEditing}" IsVisible="{Binding IsEditing}" />
              <Button Classes="apply" Content="{DynamicResource common.close}" Command="{Binding CancelCommand}"
                      IsVisible="{Binding IsFinished}" IsDefault="{Binding IsFinished}" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Center image viewport and interactive crop canvas with soft rounded border -->
      <Border Margin="16" CornerRadius="{DynamicResource SoftRadius}" ClipToBounds="True"
              Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Grid>
          <c:CropCanvas x:Name="Canvas"
                        SourceImage="{Binding PreviewImage}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" IsVisible="{Binding IsEditing}" />

          <!-- Completion summary -->
          <Border IsVisible="{Binding IsFinished}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24"
                  Classes="glass-card">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
              <ScrollViewer MaxHeight="320">
                <ItemsControl ItemsSource="{Binding Problems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" FontSize="12" Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- Loading spinner -->
          <Border IsVisible="{Binding IsBusy}" Background="#44000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
    </DockPanel>
  </Border>
</Window>
