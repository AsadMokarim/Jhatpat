<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.CreateCollageWindow"
        x:DataType="vm:CreateCollageViewModel"
        Title="Create Collage"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="1100" Height="750" MinWidth="900" MinHeight="600"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.chip-btn">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.chip-btn.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.color-chip">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.color-chip.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Margin" Value="0,2,0,8" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource SoftRadius}"
          Background="{DynamicResource GlassPanelBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="{DynamicResource GlassShadow}">
    <DockPanel>
      <!-- Top header bar -->
      <Border DockPanel.Dock="Top" Height="50" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close" Margin="4,0,0,0">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Width="30" Height="30">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Collage}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Create Collage" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding HasPhotos}">
              <TextBlock Text="{Binding PhotoCount, StringFormat='{}{0} photos'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Border>

            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding DimensionsReadout}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="chip-btn" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="chip-btn" Command="{Binding CreateCollageCommand}" IsEnabled="{Binding CanCreate}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" Padding="16,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsSaving}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsSaving}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Create Collage" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Main Content: Preview Canvas on Left, Configuration Sidebar on Right -->
      <Grid ColumnDefinitions="*, 330">
        <!-- Canvas Preview Area -->
        <Border Grid.Column="0" Background="#111116" Margin="14" CornerRadius="10" ClipToBounds="True">
          <Grid>
            <!-- Rendered Collage Preview -->
            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" Margin="16" />

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !HasPhotos}">
              <PathIcon Width="44" Height="44" Data="{StaticResource Icon.Collage}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.4" HorizontalAlignment="Center" />
              <TextBlock Text="No photos added to collage" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Add photos using the panel on the right or drag them here." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Right Configuration Sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" Spacing="14">
              <!-- Layout Selector -->
              <StackPanel Spacing="6">
                <TextBlock Text="Layout" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Grid ColumnDefinitions="*, *, *, *">
                  <Button Grid.Column="0" Classes="chip-btn" Classes.active="{Binding IsLayoutGrid}" Command="{Binding SetLayoutCommand}" CommandParameter="Grid" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
                    <TextBlock Text="Grid" FontSize="11" />
                  </Button>
                  <Button Grid.Column="1" Classes="chip-btn" Classes.active="{Binding IsLayoutRow}" Command="{Binding SetLayoutCommand}" CommandParameter="Row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0">
                    <TextBlock Text="Row" FontSize="11" />
                  </Button>
                  <Button Grid.Column="2" Classes="chip-btn" Classes.active="{Binding IsLayoutCol}" Command="{Binding SetLayoutCommand}" CommandParameter="Col" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0">
                    <TextBlock Text="Column" FontSize="11" />
                  </Button>
                  <Button Grid.Column="3" Classes="chip-btn" Classes.active="{Binding IsLayoutFeatured}" Command="{Binding SetLayoutCommand}" CommandParameter="Featured" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
                    <TextBlock Text="Featured" FontSize="11" />
                  </Button>
                </Grid>
              </StackPanel>

              <!-- Aspect Ratio -->
              <StackPanel Spacing="6">
                <TextBlock Text="Canvas Aspect Ratio" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="chip-btn" Classes.active="{Binding IsAspectSquare}" Command="{Binding SetAspectRatioCommand}" CommandParameter="1:1" Margin="0,0,6,6">
                    <TextBlock Text="1:1 Square" FontSize="11" />
                  </Button>
                  <Button Classes="chip-btn" Classes.active="{Binding IsAspect43}" Command="{Binding SetAspectRatioCommand}" CommandParameter="4:3" Margin="0,0,6,6">
                    <TextBlock Text="4:3" FontSize="11" />
                  </Button>
                  <Button Classes="chip-btn" Classes.active="{Binding IsAspect169}" Command="{Binding SetAspectRatioCommand}" CommandParameter="16:9" Margin="0,0,6,6">
                    <TextBlock Text="16:9 Landscape" FontSize="11" />
                  </Button>
                  <Button Classes="chip-btn" Classes.active="{Binding IsAspect916}" Command="{Binding SetAspectRatioCommand}" CommandParameter="9:16" Margin="0,0,6,6">
                    <TextBlock Text="9:16 Story" FontSize="11" />
                  </Button>
                  <Button Classes="chip-btn" Classes.active="{Binding IsAspect32}" Command="{Binding SetAspectRatioCommand}" CommandParameter="3:2" Margin="0,0,6,6">
                    <TextBlock Text="3:2" FontSize="11" />
                  </Button>
                  <Button Classes="chip-btn" Classes.active="{Binding IsAspect23}" Command="{Binding SetAspectRatioCommand}" CommandParameter="2:3" Margin="0,0,6,6">
                    <TextBlock Text="2:3 Portrait" FontSize="11" />
                  </Button>
                </WrapPanel>
              </StackPanel>

              <!-- Spacing, Padding & Corners -->
              <StackPanel Spacing="4">
                <DockPanel>
                  <TextBlock Text="Spacing (Gap)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding Spacing, StringFormat='{}{0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="40" Value="{Binding Spacing}" />

                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="Outer Padding" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding OuterPadding, StringFormat='{}{0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="40" Value="{Binding OuterPadding}" />

                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="Corner Radius" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding CornerRadius, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="30" Value="{Binding CornerRadius}" />
              </StackPanel>

              <!-- Background Color -->
              <StackPanel Spacing="6">
                <TextBlock Text="Background Color" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="color-chip" Classes.active="{Binding IsBgWhite}" Command="{Binding SetBgColorCommand}" CommandParameter="White" Background="White" ToolTip.Tip="White" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgBlack}" Command="{Binding SetBgColorCommand}" CommandParameter="Black" Background="Black" ToolTip.Tip="Black" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgDark}" Command="{Binding SetBgColorCommand}" CommandParameter="Dark" Background="#1A1A22" ToolTip.Tip="Dark Gray" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgAccent}" Command="{Binding SetBgColorCommand}" CommandParameter="Accent" Background="#EA580C" ToolTip.Tip="Accent Amber" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgTransparent}" Command="{Binding SetBgColorCommand}" CommandParameter="Transparent" Background="Transparent" ToolTip.Tip="Transparent" />
                </StackPanel>
              </StackPanel>

              <!-- Fit Mode -->
              <StackPanel Spacing="6">
                <TextBlock Text="Image Fitting" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Grid ColumnDefinitions="*, *">
                  <Button Grid.Column="0" Classes="chip-btn" Classes.active="{Binding IsFitFill}" Command="{Binding SetFitModeCommand}" CommandParameter="Fill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="Fill (Crop)" FontSize="11" />
                  </Button>
                  <Button Grid.Column="1" Classes="chip-btn" Classes.active="{Binding IsFitContain}" Command="{Binding SetFitModeCommand}" CommandParameter="Fit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="Fit (Contain)" FontSize="11" />
                  </Button>
                </Grid>
              </StackPanel>

              <!-- Photos Order & Actions -->
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="Photos in Collage" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Button Classes="chip-btn" Command="{Binding AddPhotosCommand}" HorizontalAlignment="Right" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Plus}" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="Add" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DockPanel>

                <!-- Photos thumbnails list -->
                <ItemsControl ItemsSource="{Binding Photos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollagePhotoItemViewModel">
                      <Border Margin="0,0,0,6" Padding="6" CornerRadius="6"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                        <DockPanel VerticalAlignment="Center">
                          <!-- Actions: Move Left/Up, Move Right/Down, Remove -->
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                            <Button Classes="icon" Command="{Binding $parent[Window].((vm:CreateCollageViewModel)DataContext).MoveLeftCommand}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding !IsFirst}" ToolTip.Tip="Move Up/Left" Width="24" Height="24">
                              <PathIcon Width="8" Height="8" Data="{StaticResource Icon.ArrowUp}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                            <Button Classes="icon" Command="{Binding $parent[Window].((vm:CreateCollageViewModel)DataContext).MoveRightCommand}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" ToolTip.Tip="Move Down/Right" Width="24" Height="24">
                              <PathIcon Width="8" Height="8" Data="{StaticResource Icon.ArrowDown}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                            <Button Classes="icon" Command="{Binding $parent[Window].((vm:CreateCollageViewModel)DataContext).RemovePhotoCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Remove" Width="24" Height="24">
                              <PathIcon Width="8" Height="8" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                          </StackPanel>

                          <!-- Tiny Thumbnail -->
                          <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border>

                          <!-- File name -->
                          <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
