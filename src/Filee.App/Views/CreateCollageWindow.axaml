<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.CreateCollageWindow"
        x:DataType="vm:CreateCollageViewModel"
        Title="Create Collage"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="1100" Height="750" MinWidth="900" MinHeight="600"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.color-chip">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.color-chip.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Margin" Value="0,2,0,8" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource DialogRadius}"
          Background="{DynamicResource GlassCardBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="0 24 64 0 #50000000, 0 2 0 0 #40FFFFFF inset">
    <DockPanel>
      <!-- Top header bar matching Tangerine modal standard -->
      <Border DockPanel.Dock="Top" Height="56" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
          <!-- Left: Circular close button -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
          </Button>

          <!-- Center: Bold window title -->
          <TextBlock Grid.Column="1" Text="Create Collage" FontWeight="Bold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Right: Badges -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding HasPhotos}">
              <TextBlock Text="{Binding PhotoCount, StringFormat='{}{0} photos'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Border>

            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding DimensionsReadout}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="reset" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="apply" Command="{Binding CreateCollageCommand}" IsEnabled="{Binding CanCreate}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsSaving}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsSaving}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Create Collage" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Main Content: Preview Canvas on Left, Configuration Sidebar on Right -->
      <Grid ColumnDefinitions="*, 330">
        <!-- Canvas Preview Area -->
        <Border Grid.Column="0" Background="#111116" Margin="16" CornerRadius="{DynamicResource SoftRadius}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
          <Grid>
            <!-- Rendered Collage Preview -->
            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" Margin="16" />

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding !HasPhotos}">
              <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <PathIcon Width="28" Height="28" Data="{StaticResource Icon.Collage}" Foreground="{DynamicResource AccentStrongBrush}" />
              </Border>
              <TextBlock Text="No photos added to collage" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Add photos using the panel on the right or drag them here." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Right Configuration Sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,18" Spacing="14">
              <!-- Layout Selector (Segmented Pill) -->
              <StackPanel Spacing="6">
                <TextBlock Text="Layout Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Border Classes="pill-group" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*, *, *, *">
                    <Button Grid.Column="0" Classes="pill" Classes.active="{Binding IsLayoutGrid}" Command="{Binding SetLayoutCommand}" CommandParameter="Grid" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <TextBlock Text="Grid" FontSize="11" />
                    </Button>
                    <Button Grid.Column="1" Classes="pill" Classes.active="{Binding IsLayoutRow}" Command="{Binding SetLayoutCommand}" CommandParameter="Row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <TextBlock Text="Row" FontSize="11" />
                    </Button>
                    <Button Grid.Column="2" Classes="pill" Classes.active="{Binding IsLayoutCol}" Command="{Binding SetLayoutCommand}" CommandParameter="Col" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <TextBlock Text="Col" FontSize="11" />
                    </Button>
                    <Button Grid.Column="3" Classes="pill" Classes.active="{Binding IsLayoutFeatured}" Command="{Binding SetLayoutCommand}" CommandParameter="Featured" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <TextBlock Text="Feat" FontSize="11" />
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Aspect Ratio -->
              <StackPanel Spacing="6">
                <TextBlock Text="Canvas Aspect Ratio" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="pill" Classes.active="{Binding IsAspectSquare}" Command="{Binding SetAspectRatioCommand}" CommandParameter="1:1" Margin="0,0,6,6">
                    <TextBlock Text="1:1" FontSize="11" />
                  </Button>
                  <Button Classes="pill" Classes.active="{Binding IsAspect43}" Command="{Binding SetAspectRatioCommand}" CommandParameter="4:3" Margin="0,0,6,6">
                    <TextBlock Text="4:3" FontSize="11" />
                  </Button>
                  <Button Classes="pill" Classes.active="{Binding IsAspect169}" Command="{Binding SetAspectRatioCommand}" CommandParameter="16:9" Margin="0,0,6,6">
                    <TextBlock Text="16:9" FontSize="11" />
                  </Button>
                  <Button Classes="pill" Classes.active="{Binding IsAspect916}" Command="{Binding SetAspectRatioCommand}" CommandParameter="9:16" Margin="0,0,6,6">
                    <TextBlock Text="9:16" FontSize="11" />
                  </Button>
                  <Button Classes="pill" Classes.active="{Binding IsAspect32}" Command="{Binding SetAspectRatioCommand}" CommandParameter="3:2" Margin="0,0,6,6">
                    <TextBlock Text="3:2" FontSize="11" />
                  </Button>
                  <Button Classes="pill" Classes.active="{Binding IsAspect23}" Command="{Binding SetAspectRatioCommand}" CommandParameter="2:3" Margin="0,0,6,6">
                    <TextBlock Text="2:3" FontSize="11" />
                  </Button>
                </WrapPanel>
              </StackPanel>

              <!-- Spacing, Padding & Corners -->
              <StackPanel Spacing="4">
                <DockPanel>
                  <TextBlock Text="Spacing (Gap)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding Spacing, StringFormat='{}{0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="40" Value="{Binding Spacing}" />

                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="Outer Padding" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding OuterPadding, StringFormat='{}{0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="40" Value="{Binding OuterPadding}" />

                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="Corner Radius" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding CornerRadius, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="30" Value="{Binding CornerRadius}" />
              </StackPanel>

              <!-- Background Color -->
              <StackPanel Spacing="6">
                <TextBlock Text="Background Color" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="color-chip" Classes.active="{Binding IsBgWhite}" Command="{Binding SetBgColorCommand}" CommandParameter="White" Background="White" ToolTip.Tip="White" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgBlack}" Command="{Binding SetBgColorCommand}" CommandParameter="Black" Background="Black" ToolTip.Tip="Black" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgDark}" Command="{Binding SetBgColorCommand}" CommandParameter="Dark" Background="#1A1A22" ToolTip.Tip="Dark Gray" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgAccent}" Command="{Binding SetBgColorCommand}" CommandParameter="Accent" Background="{DynamicResource AccentBrush}" ToolTip.Tip="Accent Color" />
                  <Button Classes="color-chip" Classes.active="{Binding IsBgTransparent}" Command="{Binding SetBgColorCommand}" CommandParameter="Transparent" Background="Transparent" ToolTip.Tip="Transparent" />
                </StackPanel>
              </StackPanel>

              <!-- Fit Mode -->
              <StackPanel Spacing="6">
                <TextBlock Text="Image Fitting" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Border Classes="pill-group" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0" Classes="pill" Classes.active="{Binding IsFitFill}" Command="{Binding SetFitModeCommand}" CommandParameter="Fill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <TextBlock Text="Fill (Crop)" FontSize="11" />
                    </Button>
                    <Button Grid.Column="1" Classes="pill" Classes.active="{Binding IsFitContain}" Command="{Binding SetFitModeCommand}" CommandParameter="Fit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <TextBlock Text="Fit (Contain)" FontSize="11" />
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Photos Order & Actions -->
              <StackPanel Spacing="8">
                <DockPanel>
                  <TextBlock Text="Photos in Collage" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Button Classes="reset" Command="{Binding AddPhotosCommand}" HorizontalAlignment="Right" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Plus}" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="Add" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DockPanel>

                <!-- Photos thumbnails list -->
                <ItemsControl ItemsSource="{Binding Photos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollagePhotoItemViewModel">
                      <Border Margin="0,0,0,6" Padding="6" CornerRadius="8"
                              Classes="glass-card">
                        <DockPanel VerticalAlignment="Center">
                          <!-- Actions: Move Left/Up, Move Right/Down, Remove -->
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                            <Button Classes="icon" Command="{Binding $parent[Window].((vm:CreateCollageViewModel)DataContext).MoveLeftCommand}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding !IsFirst}" ToolTip.Tip="Move Up/Left" Width="24" Height="24">
                              <PathIcon Width="8" Height="8" Data="{StaticResource Icon.ArrowUp}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                            <Button Classes="icon" Command="{Binding $parent[Window].((vm:CreateCollageViewModel)DataContext).MoveRightCommand}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" ToolTip.Tip="Move Down/Right" Width="24" Height="24">
                              <PathIcon Width="8" Height="8" Data="{StaticResource Icon.ArrowDown}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                            <Button Classes="icon" Command="{Binding $parent[Window].((vm:CreateCollageViewModel)DataContext).RemovePhotoCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Remove" Width="24" Height="24">
                              <PathIcon Width="8" Height="8" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                          </StackPanel>

                          <!-- Tiny Thumbnail -->
                          <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Margin="0,0,8,0">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border>

                          <!-- File name -->
                          <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
