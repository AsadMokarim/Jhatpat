<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.PdfMergeWindow"
        x:DataType="vm:PdfMergeViewModel"
        Title="Merge to PDF"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="740" Height="600" MinWidth="600" MinHeight="480"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Border Margin="16" CornerRadius="{DynamicResource DialogRadius}"
          Background="{DynamicResource GlassCardBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="0 24 64 0 #50000000, 0 2 0 0 #40FFFFFF inset">
    <DockPanel>
      <!-- Top header bar matching Tangerine modal standard -->
      <Border DockPanel.Dock="Top" Height="56" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
          <!-- Left: Circular close button -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
          </Button>

          <!-- Center: Bold window title -->
          <TextBlock Grid.Column="1" Text="Merge to PDF" FontWeight="Bold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Right: Badges -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasItems}">
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} files'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Description banner -->
      <Border DockPanel.Dock="Top" Padding="18,10" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1">
        <TextBlock Text="Combine multiple PDF documents and images into a single PDF in the exact order specified below."
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
            <Button Classes="reset" Command="{Binding AddFilesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Plus}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Add Files" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="reset" Command="{Binding ClearAllCommand}" IsVisible="{Binding HasItems}">
              <TextBlock Text="Clear All" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
            </Button>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Classes="reset" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="apply" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsProcessing}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsProcessing}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Merge to PDF" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Center file list -->
      <Grid Margin="20,14">
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding !HasItems}">
          <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
            <PathIcon Width="28" Height="28" Data="{StaticResource Icon.FilePdf}" Foreground="{DynamicResource AccentStrongBrush}" />
          </Border>
          <TextBlock Text="No documents or images selected" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Click 'Add Files' or drag PDF files and images into this window." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Document List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasItems}">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfMergeItemViewModel">
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10"
                        Classes="glass-card">
                  <DockPanel VerticalAlignment="Center">
                    <!-- Actions on right: Move Up, Move Down, Delete -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="icon" Command="{Binding $parent[Window].((vm:PdfMergeViewModel)DataContext).MoveUpCommand}"
                              CommandParameter="{Binding}" IsEnabled="{Binding !IsFirst}" ToolTip.Tip="Move Up" Width="28" Height="28">
                        <PathIcon Width="10" Height="10" Data="{StaticResource Icon.ArrowUp}" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Button>
                      <Button Classes="icon" Command="{Binding $parent[Window].((vm:PdfMergeViewModel)DataContext).MoveDownCommand}"
                              CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" ToolTip.Tip="Move Down" Width="28" Height="28">
                        <PathIcon Width="10" Height="10" Data="{StaticResource Icon.ArrowDown}" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Button>
                      <Button Classes="icon" Command="{Binding $parent[Window].((vm:PdfMergeViewModel)DataContext).RemoveItemCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Remove" Width="28" Height="28">
                        <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Button>
                    </StackPanel>

                    <!-- Sequence number badge -->
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayIndex}" FontSize="12" FontWeight="Bold"
                                 Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- PDF / Image Icon -->
                    <Panel DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                      <PathIcon Width="20" Height="20" Data="{StaticResource Icon.FilePdf}"
                                Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsPdf}" />
                      <PathIcon Width="20" Height="20" Data="{StaticResource Icon.AddBg}"
                                Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding !IsPdf}" />
                    </Panel>

                    <!-- File details -->
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DetailsText}" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
