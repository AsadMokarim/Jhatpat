<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.AnnotateWindow"
        x:DataType="vm:AnnotateViewModel"
        Title="Annotate Image"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.color-dot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.color-dot.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource DialogRadius}"
          Background="{DynamicResource GlassCardBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="0 24 64 0 #50000000, 0 2 0 0 #40FFFFFF inset">
    <DockPanel>
      <!-- Top header bar matching Tangerine modal standard -->
      <Border DockPanel.Dock="Top" Height="56" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
          <!-- Left: Circular close button -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
          </Button>

          <!-- Center: Bold window title -->
          <TextBlock Grid.Column="1" Text="Annotate &amp; Mark Up" FontWeight="Bold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Right: Badges -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
            </Border>

            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding ResolutionText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Annotation Tools Toolbar -->
      <Border DockPanel.Dock="Top" Padding="16,8" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel VerticalAlignment="Center">
          <!-- Undo / Redo / Clear on Right -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="reset" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)" Padding="8,5">
              <PathIcon Width="11" Height="11" Data="{StaticResource Icon.Refresh}" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <Button Classes="reset" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)" Padding="8,5">
              <PathIcon Width="11" Height="11" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <Button Classes="reset" Command="{Binding ClearAllCommand}" ToolTip.Tip="Clear All Annotations" Padding="8,5">
              <PathIcon Width="11" Height="11" Data="{StaticResource Icon.Delete}" Foreground="{DynamicResource DangerBrush}" />
            </Button>
          </StackPanel>

          <!-- Tools and properties on Left -->
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Tool selection pill group -->
            <Border Classes="pill-group" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="pill" Classes.active="{Binding IsToolPen}" Command="{Binding SetToolCommand}" CommandParameter="Pen" ToolTip.Tip="Freehand Pen">
                  <TextBlock Text="Pen" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolArrow}" Command="{Binding SetToolCommand}" CommandParameter="Arrow" ToolTip.Tip="Arrow Pointer">
                  <TextBlock Text="Arrow" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolRect}" Command="{Binding SetToolCommand}" CommandParameter="Rect" ToolTip.Tip="Rectangle Box">
                  <TextBlock Text="Box" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolEllipse}" Command="{Binding SetToolCommand}" CommandParameter="Ellipse" ToolTip.Tip="Ellipse / Circle">
                  <TextBlock Text="Circle" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolLine}" Command="{Binding SetToolCommand}" CommandParameter="Line" ToolTip.Tip="Straight Line">
                  <TextBlock Text="Line" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolHighlight}" Command="{Binding SetToolCommand}" CommandParameter="Highlight" ToolTip.Tip="Highlighter Marker">
                  <TextBlock Text="Highlight" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolRedact}" Command="{Binding SetToolCommand}" CommandParameter="Redact" ToolTip.Tip="Redact / Obscure Box">
                  <TextBlock Text="Redact" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolBadge}" Command="{Binding SetToolCommand}" CommandParameter="Badge" ToolTip.Tip="Numbered Callout">
                  <TextBlock Text="1,2,3" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsToolText}" Command="{Binding SetToolCommand}" CommandParameter="Text" ToolTip.Tip="Text Note">
                  <TextBlock Text="Text" />
                </Button>
              </StackPanel>
            </Border>

            <!-- Color Palette -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
              <Button Classes="color-dot" Classes.active="{Binding IsColorRed}" Command="{Binding SetColorCommand}" CommandParameter="Red" Background="#EF4444" ToolTip.Tip="Red" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorOrange}" Command="{Binding SetColorCommand}" CommandParameter="Orange" Background="#FA4616" ToolTip.Tip="Tangerine Orange" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorYellow}" Command="{Binding SetColorCommand}" CommandParameter="Yellow" Background="#EAB308" ToolTip.Tip="Yellow" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorGreen}" Command="{Binding SetColorCommand}" CommandParameter="Green" Background="#22C55E" ToolTip.Tip="Green" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorBlue}" Command="{Binding SetColorCommand}" CommandParameter="Blue" Background="#3B82F6" ToolTip.Tip="Blue" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorPurple}" Command="{Binding SetColorCommand}" CommandParameter="Purple" Background="#A855F7" ToolTip.Tip="Purple" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorWhite}" Command="{Binding SetColorCommand}" CommandParameter="White" Background="White" ToolTip.Tip="White" />
              <Button Classes="color-dot" Classes.active="{Binding IsColorBlack}" Command="{Binding SetColorCommand}" CommandParameter="Black" Background="Black" ToolTip.Tip="Black" />
            </StackPanel>

            <!-- Stroke width pills -->
            <Border Classes="pill-group" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="pill" Command="{Binding SetStrokeCommand}" CommandParameter="2">
                  <TextBlock Text="Thin" FontSize="11" />
                </Button>
                <Button Classes="pill" Command="{Binding SetStrokeCommand}" CommandParameter="4">
                  <TextBlock Text="Med" FontSize="11" />
                </Button>
                <Button Classes="pill" Command="{Binding SetStrokeCommand}" CommandParameter="8">
                  <TextBlock Text="Thick" FontSize="11" />
                </Button>
              </StackPanel>
            </Border>

            <!-- Text input field when Text tool active -->
            <TextBox Text="{Binding TextInput}" Width="160" Classes="glass" FontSize="12" Padding="8,4" VerticalAlignment="Center"
                     PlaceholderText="Enter note..." IsVisible="{Binding IsToolText}" />
          </WrapPanel>
        </DockPanel>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="reset" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="apply" Command="{Binding SaveAnnotatedCopyCommand}" IsEnabled="{Binding !IsSaving}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsSaving}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsSaving}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Save Annotated Copy" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Main Canvas Drawing Area -->
      <Border Background="#111116" Margin="16" CornerRadius="{DynamicResource SoftRadius}"
              BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="CanvasContainer" Background="Transparent">
          <Image x:Name="CanvasImage" Source="{Binding PreviewBitmap}" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Grid>
      </Border>
    </DockPanel>
  </Border>
</Window>
