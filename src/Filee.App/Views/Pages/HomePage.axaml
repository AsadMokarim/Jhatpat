<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:app="using:Filee.App.ViewModels"
             x:Class="Filee.App.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteImageCommand}" />
    <KeyBinding Gesture="Cmd+V" Command="{Binding PasteImageCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding BrowseFilesCommand}" />
    <KeyBinding Gesture="Cmd+O" Command="{Binding BrowseFilesCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Border#DropZone">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#DropZone.over">
      <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource GlassGlowShadow}" />
      <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>
    <Style Selector="PathIcon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="PathIcon.chevron.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="22">
    <TextBlock Classes="h1" Text="{DynamicResource home.title}" />

    <!-- macOS without Accessibility permission: the drag gesture can't work yet. Gone once it is given. -->
    <Border IsVisible="{Binding NeedsAccessibility}" Background="{DynamicResource AccentFaintBrush}"
            BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="{DynamicResource SoftRadius}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource triggers.open_accessibility}" Command="{Binding OpenAccessibilityCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource home.accessibility_needed}" />
      </DockPanel>
    </Border>

    <!-- Windows: Filee runs as administrator while Explorer doesn't. Explorer can't drop files here, use the menu or
         have its selection read until Filee runs with normal rights again. -->
    <Border IsVisible="{Binding IsElevated}" Background="{DynamicResource AccentFaintBrush}"
            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="{DynamicResource SoftRadius}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource home.elevated_restart}" Command="{Binding RestartWithoutAdministratorRightsCommand}" />
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock TextWrapping="Wrap" Text="{DynamicResource home.elevated}" />
          <TextBlock Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding ElevationRestartFailed}"
                     Text="{DynamicResource home.elevated_restart_failed}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Drop zone: files dropped here open the donut toolbar at the cursor. -->
    <Border x:Name="DropZone" DragDrop.AllowDrop="True" MinHeight="220"
            Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1.5" CornerRadius="{DynamicResource SoftRadiusLarge}" Padding="26"
            BoxShadow="{DynamicResource GlassShadow}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center"
                BoxShadow="0 4 16 0 #28FF7418">
          <PathIcon Width="28" Height="28" Data="{StaticResource Icon.Upload}" Foreground="{DynamicResource AccentStrongBrush}" />
        </Border>
        <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{DynamicResource home.drop_title}" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                   Text="{Binding DropHint}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button Classes="accent" Command="{Binding PasteImageCommand}" Padding="15,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Copy}" />
              <TextBlock Text="{DynamicResource clipboard.paste_image}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="glass" Command="{Binding BrowseFilesCommand}" Padding="15,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Folder}" />
              <TextBlock Text="{DynamicResource home.browse_files}" />
            </StackPanel>
          </Button>
          <Button Classes="glass" Command="{Binding CaptureScreenshotCommand}" IsVisible="{Binding IsScreenshotSupported}" Padding="15,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Camera}" />
              <TextBlock Text="{DynamicResource screenshot.capture}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Recent conversions -->
    <StackPanel Spacing="10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" Content="{DynamicResource home.clear_history}" Command="{Binding ClearHistoryCommand}" />
        <TextBlock Classes="h2" VerticalAlignment="Center" Text="{DynamicResource home.recent}" />
      </DockPanel>
      <TextBox Classes="search" Text="{Binding Search}" PlaceholderText="{DynamicResource common.search}"
               IsVisible="{Binding !IsEmpty}">
        <TextBox.InnerLeftContent>
          <PathIcon Width="14" Height="14" Margin="10,0,0,0" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <TextBlock Classes="muted" Text="{DynamicResource home.recent_empty}" IsVisible="{Binding IsEmpty}" />
      <TextBlock Classes="muted" Text="{DynamicResource home.no_matches}" IsVisible="{Binding NoMatches}" />
      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItemViewModel">
            <Border Classes="card" Padding="14,10">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Classes="glass" Command="{Binding OpenOutputCommand}" IsVisible="{Binding CanOpenOutput}" Padding="10,5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" />
                        <TextBlock Text="{DynamicResource home.open_file}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="glass" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}" Padding="10,5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Folder}" />
                        <TextBlock Text="{DynamicResource home.open_folder}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Command="{Binding RemoveCommand}" ToolTip.Tip="{DynamicResource home.remove_entry}" Padding="8,5">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Delete}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                  </StackPanel>
                  <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="999" Margin="0,0,12,0"
                          Background="{DynamicResource AccentSoftBrush}">
                    <Panel>
                      <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource AccentStrongBrush}" IsVisible="{Binding !HasErrors}" />
                      <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasErrors}" />
                    </Panel>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                      <TextBlock Classes="caption" Text="·" />
                      <TextBlock Classes="caption" Text="{Binding Time}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>

                <!-- Failed files: the list on demand, and converting them again -->
                <DockPanel IsVisible="{Binding HasFailures}" Margin="44,0,0,0">
                  <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                      <TextBlock Text="{DynamicResource common.retry}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" Command="{Binding ToggleFailuresCommand}" Padding="6,4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="chevron" Classes.open="{Binding ShowFailures}" Width="12" Height="12"
                                Data="{StaticResource Icon.ChevronRight}" />
                      <TextBlock Classes="caption danger" Text="{Binding FailureSummary}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Failures}" IsVisible="{Binding ShowFailures}" Margin="50,0,0,2">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="app:FailureItem">
                      <StackPanel>
                        <SelectableTextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                        <SelectableTextBlock Classes="caption danger" Text="{Binding Reason}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
