<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.EditPhotoWindow"
        x:DataType="vm:EditPhotoViewModel"
        Title="Edit Photo"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="1080" Height="740" MinWidth="880" MinHeight="600"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Gesture="R" Command="{Binding ResetAllCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.tab-btn">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tab-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tab-btn.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Margin" Value="0,2,0,8" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource SoftRadius}"
          Background="{DynamicResource GlassPanelBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="{DynamicResource GlassShadow}">
    <DockPanel>
      <!-- Top header bar -->
      <Border DockPanel.Dock="Top" Height="50" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close" Margin="4,0,0,0">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Width="30" Height="30">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Tune}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Edit Photo" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            </Border>

            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding ResolutionText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>

            <!-- Compare Button -->
            <Button Classes="tab-btn" Command="{Binding ToggleCompareCommand}" Margin="12,0,0,0"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Copy}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding IsComparing, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, StringFormat='{}{0}'}" VerticalAlignment="Center">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                      <Binding Path="IsComparing" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="Compare" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
            <Button Classes="tab-btn" Command="{Binding ResetAllCommand}" ToolTip.Tip="Reset all sliders to defaults (R)"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Refresh}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Reset All" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Classes="tab-btn" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="tab-btn" Command="{Binding SaveCopyCommand}" IsEnabled="{Binding !IsSaving}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" Padding="16,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsSaving}" />
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsSaving}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Save Edited Copy" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Main Layout: Preview on Left, Adjustments Panel on Right -->
      <Grid ColumnDefinitions="*, 330">
        <!-- Image Preview Area -->
        <Border Grid.Column="0" Background="#111116" Margin="14" CornerRadius="10" ClipToBounds="True">
          <Grid>
            <!-- Adjusted Preview -->
            <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding !IsComparing}" />

            <!-- Original Preview for Compare -->
            <Image Source="{Binding OriginalPreviewBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding IsComparing}" />

            <!-- Compare Watermark Badge -->
            <Border Background="#CC000000" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    IsVisible="{Binding IsComparing}">
              <TextBlock Text="ORIGINAL PHOTO" FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>
          </Grid>
        </Border>

        <!-- Right Adjustments Sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1,0,0,0">
          <DockPanel>
            <!-- Tabs: Light / Color / Detail -->
            <Border DockPanel.Dock="Top" Height="44" Padding="8,6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*, *, *">
                <Button Grid.Column="0" Classes="tab-btn" Classes.active="{Binding IsTabLight}" Command="{Binding SelectTabCommand}" CommandParameter="Light" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <TextBlock Text="Light" FontWeight="SemiBold" />
                </Button>
                <Button Grid.Column="1" Classes="tab-btn" Classes.active="{Binding IsTabColor}" Command="{Binding SelectTabCommand}" CommandParameter="Color" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <TextBlock Text="Color" FontWeight="SemiBold" />
                </Button>
                <Button Grid.Column="2" Classes="tab-btn" Classes.active="{Binding IsTabDetail}" Command="{Binding SelectTabCommand}" CommandParameter="Detail" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <TextBlock Text="Detail" FontWeight="SemiBold" />
                </Button>
              </Grid>
            </Border>

            <!-- Sliders Content Area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16" Spacing="4">
                <!-- LIGHT CONTROLS -->
                <StackPanel Spacing="4" IsVisible="{Binding IsTabLight}">
                  <!-- Exposure -->
                  <DockPanel>
                    <TextBlock Text="Exposure" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Exposure, StringFormat='{}{0:+0.0;-0.0;0.0} EV'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-2.0" Maximum="2.0" Value="{Binding Exposure}" TickFrequency="0.1" IsSnapToTickEnabled="True" />

                  <!-- Brightness -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Brightness" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Brightness, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" />

                  <!-- Contrast -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Contrast" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Contrast, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />

                  <!-- Highlights -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Highlights" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Highlights, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Highlights}" />

                  <!-- Shadows -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Shadows" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Shadows, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Shadows}" />

                  <!-- Whites -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Whites" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Whites, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Whites}" />

                  <!-- Blacks -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Blacks" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Blacks, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Blacks}" />

                  <!-- Gamma -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Gamma" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Gamma, StringFormat='{}{0:0.00}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="0.2" Maximum="2.5" Value="{Binding Gamma}" />

                  <Button Classes="tab-btn" Command="{Binding ResetLightCommand}" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Reset Light" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>

                <!-- COLOR CONTROLS -->
                <StackPanel Spacing="4" IsVisible="{Binding IsTabColor}">
                  <!-- Temperature -->
                  <DockPanel>
                    <TextBlock Text="Temperature (Cool / Warm)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Temperature, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Temperature}" />

                  <!-- Tint -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Tint (Green / Magenta)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Tint, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Tint}" />

                  <!-- Saturation -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Saturation" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Saturation, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" />

                  <!-- Vibrance -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Vibrance" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Vibrance, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Vibrance}" />

                  <!-- Hue Shift -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Hue Shift" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Hue, StringFormat='{}{0:+0;-0;0}°'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Hue}" />

                  <Button Classes="tab-btn" Command="{Binding ResetColorCommand}" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Reset Color" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>

                <!-- DETAIL CONTROLS -->
                <StackPanel Spacing="4" IsVisible="{Binding IsTabDetail}">
                  <!-- Dehaze -->
                  <DockPanel>
                    <TextBlock Text="Dehaze" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Dehaze, StringFormat='{}{0:0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="0" Maximum="100" Value="{Binding Dehaze}" />

                  <!-- Clarity -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Clarity" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Clarity, StringFormat='{}{0:+0;-0;0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Clarity}" />

                  <!-- Film Grain -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Film Grain" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Grain, StringFormat='{}{0:0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="0" Maximum="100" Value="{Binding Grain}" />

                  <!-- Noise Reduction -->
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Noise Reduction" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding NoiseReduction, StringFormat='{}{0:0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider Minimum="0" Maximum="100" Value="{Binding NoiseReduction}" />

                  <Button Classes="tab-btn" Command="{Binding ResetDetailCommand}" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Reset Detail" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
