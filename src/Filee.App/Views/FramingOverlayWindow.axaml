<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        xmlns:svc="using:Filee.App.Services"
        xmlns:c="using:Filee.App.Controls"
        x:Class="Filee.App.Views.FramingOverlayWindow"
        x:DataType="vm:FramingOverlayViewModel"
        Title="{DynamicResource frame.title}"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="1080" Height="740" MinWidth="800" MinHeight="580"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.aspect">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.aspect:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.aspect.active">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#44FFFFFF" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Styles>

  <!-- Overlay card with soft rounded corners and theme styling -->
  <Border Margin="16" CornerRadius="{DynamicResource DialogRadius}"
          Background="{DynamicResource GlassCardBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="0 24 64 0 #50000000, 0 2 0 0 #40FFFFFF inset">
    <DockPanel>
      <!-- Top header bar matching Tangerine modal standard -->
      <Border DockPanel.Dock="Top" Height="56" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
          <!-- Left: Circular close button -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CancelCommand}" ToolTip.Tip="{DynamicResource common.cancel}">
            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
          </Button>

          <!-- Center: Bold window title -->
          <TextBlock Grid.Column="1" Text="{DynamicResource frame.title}" FontWeight="Bold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Right: Badges -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" IsVisible="{Binding IsEditing}">
              <TextBlock Text="{Binding CurrentFileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
            </Border>

            <Border IsVisible="{Binding HasMultipleFiles}" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3">
              <TextBlock Text="{Binding CounterText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>

            <Border IsVisible="{Binding HasStatusNotice}" Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
              <TextBlock Text="{Binding StatusNotice}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis" MaxWidth="180" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{DynamicResource common.close}" Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsFinished}" IsDefault="{Binding IsFinished}" Classes="apply" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsEditing}">
            <Button Content="{DynamicResource frame.reset}" Command="{Binding ResetCommand}" Classes="reset" />
            <Button Content="{DynamicResource crop.skip}" Command="{Binding SkipCommand}" IsVisible="{Binding HasMultipleFiles}" Classes="reset" />
            <Button Command="{Binding CopyToClipboardCommand}" Classes="reset" ToolTip.Tip="{DynamicResource clipboard.copy_image}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Copy}" />
                <TextBlock Text="{DynamicResource clipboard.copy_image}" />
              </StackPanel>
            </Button>
            <Button Content="Save As..." Command="{Binding SaveAsCommand}" Classes="reset" />
            <Button Content="{DynamicResource frame.save}" Command="{Binding FrameAndSaveCommand}"
                    IsDefault="{Binding IsEditing}" Classes="apply" />
          </StackPanel>

          <!-- Aspect ratio segmented pill on the bottom left -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsEditing}">
            <Border Classes="pill-group" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="pill" Classes.active="{Binding IsAspectOriginal}" Content="{DynamicResource crop.aspect_original}" Command="{Binding SetAspectCommand}" CommandParameter="original" />
                <Button Classes="pill" Classes.active="{Binding IsAspectSquare}" Content="1:1" Command="{Binding SetAspectCommand}" CommandParameter="1:1" />
                <Button Classes="pill" Classes.active="{Binding IsAspect45}" Content="4:5" Command="{Binding SetAspectCommand}" CommandParameter="4:5" />
                <Button Classes="pill" Classes.active="{Binding IsAspect916}" Content="9:16" Command="{Binding SetAspectCommand}" CommandParameter="9:16" />
                <Button Classes="pill" Classes.active="{Binding IsAspect169}" Content="16:9" Command="{Binding SetAspectCommand}" CommandParameter="16:9" />
                <Button Classes="pill" Classes.active="{Binding IsAspect43}" Content="4:3" Command="{Binding SetAspectCommand}" CommandParameter="4:3" />
                <Button Classes="pill" Classes.active="{Binding IsAspectCustom}" Content="{DynamicResource frame.aspect_custom}" Command="{Binding SetAspectCommand}" CommandParameter="custom" />
              </StackPanel>
            </Border>

            <!-- Custom numeric dimensions -->
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsAspectCustom}">
              <TextBlock Text="{DynamicResource frame.custom_width}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              <NumericUpDown Value="{Binding CustomWidth}" Minimum="32" Maximum="10000" Increment="50" FormatString="0"
                             Width="80" Height="28" Padding="4,2" VerticalAlignment="Center" />
              <TextBlock Text="×" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0" />
              <TextBlock Text="{DynamicResource frame.custom_height}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              <NumericUpDown Value="{Binding CustomHeight}" Minimum="32" Maximum="10000" Increment="50" FormatString="0"
                             Width="80" Height="28" Padding="4,2" VerticalAlignment="Center" />
            </StackPanel>

            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
              <TextBlock Text="{Binding DimensionsText}" FontSize="11" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Right controls sidebar -->
      <Border DockPanel.Dock="Right" Width="280" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0"
              Background="{DynamicResource SurfaceBrush}" Padding="16" IsVisible="{Binding IsEditing}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            <!-- Background section -->
            <StackPanel Spacing="8">
              <TextBlock Text="Background" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="aspect" Classes.active="{Binding IsSolidBg}" Content="{DynamicResource frame.bg_solid}"
                        Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static svc:FramingBackgroundType.SolidColor}" Margin="0,0,4,4" />
                <Button Classes="aspect" Classes.active="{Binding IsGradientBg}" Content="{DynamicResource frame.bg_gradient}"
                        Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static svc:FramingBackgroundType.Gradient}" Margin="0,0,4,4" />
                <Button Classes="aspect" Classes.active="{Binding IsTransparentBg}" Content="{DynamicResource frame.bg_transparent}"
                        Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static svc:FramingBackgroundType.Transparent}" Margin="0,0,4,4" />
                <Button Classes="aspect" Classes.active="{Binding IsImageBg}" Content="{DynamicResource frame.bg_image}"
                        Command="{Binding BrowseBackgroundImageCommand}" Margin="0,0,4,4" />
              </WrapPanel>

              <!-- Solid color section with picker, swatches, and mixer -->
              <StackPanel IsVisible="{Binding IsSolidBg}" Spacing="8" Margin="0,4,0,0">
                <!-- Selected color swatch + Hex input -->
                <DockPanel VerticalAlignment="Center">
                  <Border Width="28" Height="28" CornerRadius="6"
                          Background="{Binding CurrentColorBrush}"
                          BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                          Margin="0,0,8,0" BoxShadow="0 1 3 #20000000" />
                  <Button DockPanel.Dock="Right" Classes="aspect" Content="Reset" Command="{Binding SetSolidColorCommand}" CommandParameter="#1E1E2E" Padding="6,3" FontSize="11" Margin="6,0,0,0" ToolTip.Tip="Reset to default color" />
                  <TextBox Text="{Binding HexInputText, Mode=TwoWay}"
                           PlaceholderText="#RRGGBB"
                           FontFamily="Consolas, monospace"
                           FontSize="12"
                           Padding="6,4"
                           VerticalAlignment="Center" />
                </DockPanel>

                <!-- Color presets chips -->
                <TextBlock Text="{DynamicResource frame.color_presets}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="chip" Background="#1E1E2E" Command="{Binding SetSolidColorCommand}" CommandParameter="#1E1E2E" Margin="0,0,6,6" ToolTip.Tip="Slate Dark" />
                  <Button Classes="chip" Background="#FFFFFF" Command="{Binding SetSolidColorCommand}" CommandParameter="#FFFFFF" Margin="0,0,6,6" ToolTip.Tip="Pure White" />
                  <Button Classes="chip" Background="#000000" Command="{Binding SetSolidColorCommand}" CommandParameter="#000000" Margin="0,0,6,6" ToolTip.Tip="Pitch Black" />
                  <Button Classes="chip" Background="#0F172A" Command="{Binding SetSolidColorCommand}" CommandParameter="#0F172A" Margin="0,0,6,6" ToolTip.Tip="Midnight" />
                  <Button Classes="chip" Background="#2D3748" Command="{Binding SetSolidColorCommand}" CommandParameter="#2D3748" Margin="0,0,6,6" ToolTip.Tip="Charcoal" />
                  <Button Classes="chip" Background="#4338CA" Command="{Binding SetSolidColorCommand}" CommandParameter="#4338CA" Margin="0,0,6,6" ToolTip.Tip="Indigo" />
                  <Button Classes="chip" Background="#3B82F6" Command="{Binding SetSolidColorCommand}" CommandParameter="#3B82F6" Margin="0,0,6,6" ToolTip.Tip="Sky Blue" />
                  <Button Classes="chip" Background="#06B6D4" Command="{Binding SetSolidColorCommand}" CommandParameter="#06B6D4" Margin="0,0,6,6" ToolTip.Tip="Cyan" />
                  <Button Classes="chip" Background="#10B981" Command="{Binding SetSolidColorCommand}" CommandParameter="#10B981" Margin="0,0,6,6" ToolTip.Tip="Emerald" />
                  <Button Classes="chip" Background="#F59E0B" Command="{Binding SetSolidColorCommand}" CommandParameter="#F59E0B" Margin="0,0,6,6" ToolTip.Tip="Amber" />
                  <Button Classes="chip" Background="#F43F5E" Command="{Binding SetSolidColorCommand}" CommandParameter="#F43F5E" Margin="0,0,6,6" ToolTip.Tip="Rose" />
                  <Button Classes="chip" Background="#E5E7EB" Command="{Binding SetSolidColorCommand}" CommandParameter="#E5E7EB" Margin="0,0,6,6" ToolTip.Tip="Soft Gray" />
                </WrapPanel>

                <!-- Interactive RGB Color Mixer -->
                <Expander Header="{DynamicResource frame.color_mixer}" IsExpanded="False" Margin="0,2,0,0">
                  <StackPanel Spacing="6" Margin="0,6,0,0">
                    <DockPanel>
                      <TextBlock Text="R" Width="14" FontSize="11" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ColorR}" Width="28" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                      <Slider Minimum="0" Maximum="255" Value="{Binding ColorR}" SmallChange="1" LargeChange="16" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="G" Width="14" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ColorG}" Width="28" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                      <Slider Minimum="0" Maximum="255" Value="{Binding ColorG}" SmallChange="1" LargeChange="16" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="B" Width="14" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ColorB}" Width="28" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                      <Slider Minimum="0" Maximum="255" Value="{Binding ColorB}" SmallChange="1" LargeChange="16" Margin="4,0" />
                    </DockPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>

              <!-- Gradient presets -->
              <StackPanel IsVisible="{Binding IsGradientBg}" Spacing="6" Margin="0,4,0,0">
                <TextBlock Text="Gradient Presets" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="aspect" Content="Indigo Pink" Command="{Binding SetGradientCommand}" CommandParameter="#4F46E5,#EC4899" Margin="0,0,4,4" FontSize="11" Padding="6,3" />
                  <Button Classes="aspect" Content="Sunset" Command="{Binding SetGradientCommand}" CommandParameter="#FF512F,#DD2476" Margin="0,0,4,4" FontSize="11" Padding="6,3" />
                  <Button Classes="aspect" Content="Ocean" Command="{Binding SetGradientCommand}" CommandParameter="#06B6D4,#3B82F6" Margin="0,0,4,4" FontSize="11" Padding="6,3" />
                  <Button Classes="aspect" Content="Emerald" Command="{Binding SetGradientCommand}" CommandParameter="#10B981,#059669" Margin="0,0,4,4" FontSize="11" Padding="6,3" />
                  <Button Classes="aspect" Content="Purple Amber" Command="{Binding SetGradientCommand}" CommandParameter="#8B5CF6,#F59E0B" Margin="0,0,4,4" FontSize="11" Padding="6,3" />
                  <Button Classes="aspect" Content="Dark Minimal" Command="{Binding SetGradientCommand}" CommandParameter="#2C3E50,#000000" Margin="0,0,4,4" FontSize="11" Padding="6,3" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>

            <Separator Background="{DynamicResource SubtleBorderBrush}" Height="1" />

            <!-- Padding slider -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="{DynamicResource frame.padding}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Padding, StringFormat={}{0} px}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              </DockPanel>
              <Slider Minimum="0" Maximum="160" Value="{Binding Padding}" SmallChange="4" LargeChange="16" />
            </StackPanel>

            <!-- Corner radius slider -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="{DynamicResource frame.radius}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding CornerRadius, StringFormat={}{0:F0} px}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              </DockPanel>
              <Slider Minimum="0" Maximum="80" Value="{Binding CornerRadius}" SmallChange="2" LargeChange="8" />
            </StackPanel>

            <!-- Image positioning / Center button -->
            <StackPanel Spacing="4" Margin="0,2,0,0">
              <DockPanel>
                <TextBlock Text="{DynamicResource frame.center_image}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Classes="aspect" Content="Reset" Command="{Binding ResetPositionCommand}" IsEnabled="{Binding HasOffset}"
                        HorizontalAlignment="Right" Padding="8,3" FontSize="11" ToolTip.Tip="Reset image position to center" />
              </DockPanel>
            </StackPanel>

            <Separator Background="{DynamicResource SubtleBorderBrush}" Height="1" />

            <!-- Drop shadow toggle -->
            <StackPanel Spacing="6">
              <DockPanel>
                <TextBlock Text="{DynamicResource frame.shadow}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding HasShadow}" OnContent="" OffContent="" HorizontalAlignment="Right" />
              </DockPanel>
              <StackPanel IsVisible="{Binding HasShadow}" Spacing="4">
                <DockPanel>
                  <TextBlock Text="Blur / Spread" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding ShadowBlur, StringFormat={}{0:F0}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
                <Slider Minimum="2" Maximum="40" Value="{Binding ShadowBlur}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Center image viewport / preview -->
      <Grid Background="{DynamicResource PageBrush}">
        <!-- Checkerboard pattern for transparency clarity -->
        <Border x:Name="PreviewBorder" Margin="24" CornerRadius="8" ClipToBounds="True" BoxShadow="0 2 12 #20000000"
                Background="Transparent">
          <Grid>
            <Image x:Name="PreviewImageControl"
                   Source="{Binding PreviewImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsEditing}" />
            <c:FramingTransformControl x:Name="TransformOverlay"
                                       AccentBrush="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       IsVisible="{Binding IsEditing}" />
          </Grid>
        </Border>

        <!-- Summary panel when finished -->
        <Border IsVisible="{Binding IsFinished}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource SoftRadius}" Padding="20,16">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ScrollViewer MaxHeight="320">
              <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="12" Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Busy indicator -->
        <Border IsVisible="{Binding IsBusy}" Background="#44000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <ProgressBar IsIndeterminate="True" Width="80" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
