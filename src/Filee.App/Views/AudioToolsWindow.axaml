<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.AudioToolsWindow"
        x:DataType="vm:AudioToolsViewModel"
        Title="Audio Tools"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="840" Height="540" MinWidth="680" MinHeight="460"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.tab-btn">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tab-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tab-btn.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.chip-btn">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip-btn.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action-btn">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Styles>

  <Border Margin="16" CornerRadius="{DynamicResource SoftRadius}"
          Background="{DynamicResource GlassPanelBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="{DynamicResource GlassShadow}">
    <DockPanel>
      <!-- Top header bar -->
      <Border DockPanel.Dock="Top" Height="50" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close" Margin="4,0,0,0">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Width="30" Height="30">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Volume}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Audio Tools" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            </Border>

            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalDurationText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding FormatInfo}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Tabs Navigation -->
      <Border DockPanel.Dock="Top" Height="44" Padding="14,4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="tab-btn" Classes.active="{Binding IsTabNormalize}" Command="{Binding SelectTabCommand}" CommandParameter="Normalize">
            <TextBlock Text="Normalize Volume" />
          </Button>
          <Button Classes="tab-btn" Classes.active="{Binding IsTabTrim}" Command="{Binding SelectTabCommand}" CommandParameter="Trim">
            <TextBlock Text="Trim Audio" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="action-btn" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- TAB CONTENT -->
      <Grid Margin="22">
        <!-- 1. NORMALIZE VOLUME TAB -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTabNormalize}">
          <StackPanel Spacing="16" MaxWidth="580" HorizontalAlignment="Left">
            <TextBlock Text="Standardize loudness across podcast episodes, music, or speech recordings"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Standard Presets -->
            <StackPanel Spacing="6">
              <TextBlock Text="Loudness Standards" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="chip-btn" Classes.active="{Binding IsStandardPodcast}" Command="{Binding SetStandardLufsCommand}" CommandParameter="-16" Margin="0,0,6,6">
                  <TextBlock Text="-16 LUFS (Podcasts &amp; Voice)" />
                </Button>
                <Button Classes="chip-btn" Classes.active="{Binding IsStandardStreaming}" Command="{Binding SetStandardLufsCommand}" CommandParameter="-14" Margin="0,0,6,6">
                  <TextBlock Text="-14 LUFS (Streaming / YouTube / Spotify)" />
                </Button>
                <Button Classes="chip-btn" Classes.active="{Binding IsStandardBroadcast}" Command="{Binding SetStandardLufsCommand}" CommandParameter="-23" Margin="0,0,6,6">
                  <TextBlock Text="-23 LUFS (EBU R128 Broadcast)" />
                </Button>
              </WrapPanel>
            </StackPanel>

            <!-- Target Loudness Slider -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Integrated Loudness" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding TargetLufs, StringFormat='{}{0:0.0} LUFS'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="-30.0" Maximum="-10.0" Value="{Binding TargetLufs}" TickFrequency="0.5" />
            </StackPanel>

            <!-- True Peak Slider -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Maximum True Peak" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding TruePeak, StringFormat='{}{0:0.0} dBTP'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="-3.0" Maximum="-0.5" Value="{Binding TruePeak}" TickFrequency="0.1" />
            </StackPanel>

            <Button Classes="action-btn" Command="{Binding NormalizeAudioCommand}" IsEnabled="{Binding !IsProcessing}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsProcessing}" />
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Volume}" IsVisible="{Binding !IsProcessing}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Normalize Audio Volume" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- 2. TRIM AUDIO TAB -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTabTrim}">
          <StackPanel Spacing="16" MaxWidth="580" HorizontalAlignment="Left">
            <TextBlock Text="Trim start and end points of audio recording" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- Sliders -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Start Position" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StartTimeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="0" Maximum="{Binding TotalDurationSeconds}" Value="{Binding StartTimeSeconds}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="End Position" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding EndTimeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="0" Maximum="{Binding TotalDurationSeconds}" Value="{Binding EndTimeSeconds}" />
            </StackPanel>

            <!-- Duration Readout -->
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
              <DockPanel>
                <TextBlock Text="Trimmed Selection Duration:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TrimDurationText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <Button Classes="action-btn" Command="{Binding TrimAudioCommand}" IsEnabled="{Binding !IsProcessing}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsProcessing}" />
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsProcessing}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Trim and Save Audio" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
