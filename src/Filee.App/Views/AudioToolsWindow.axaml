<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.AudioToolsWindow"
        x:DataType="vm:AudioToolsViewModel"
        Title="Audio Tools"
        Icon="avares://Filee/Assets/Icons/jhatpat.ico"
        Width="840" Height="560" MinWidth="680" MinHeight="460"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>

  <Border Margin="16" CornerRadius="{DynamicResource DialogRadius}"
          Background="{DynamicResource GlassCardBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
          ClipToBounds="True"
          BoxShadow="0 24 64 0 #50000000, 0 2 0 0 #40FFFFFF inset">
    <DockPanel>
      <!-- Top header bar matching Tangerine modal standard -->
      <Border DockPanel.Dock="Top" Height="56" Padding="18,0" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource GlassHeaderBrush}">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
          <!-- Left: Circular close button -->
          <Button Grid.Column="0" Classes="close-circle" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
          </Button>

          <!-- Center: Bold window title -->
          <TextBlock Grid.Column="1" Text="Audio Tools" FontWeight="Bold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Right: Badges -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" MaxWidth="160" TextTrimming="CharacterEllipsis" />
            </Border>

            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalDurationText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Segmented Pill Tabs Navigation -->
      <Border DockPanel.Dock="Top" Margin="14,12,14,6">
        <Border Classes="pill-group" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="pill" Classes.active="{Binding IsTabNormalize}" Command="{Binding SelectTabCommand}" CommandParameter="Normalize">
              <TextBlock Text="Normalize Volume" />
            </Button>
            <Rectangle Classes="pill-divider" />
            <Button Classes="pill" Classes.active="{Binding IsTabTrim}" Command="{Binding SelectTabCommand}" CommandParameter="Trim">
              <TextBlock Text="Trim Audio" />
            </Button>
          </StackPanel>
        </Border>
      </Border>

      <!-- Bottom action bar -->
      <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
              Background="{DynamicResource GlassHeaderBrush}">
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="reset" Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsFinished}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- TAB CONTENT -->
      <Grid Margin="24,14,24,20">
        <!-- 1. NORMALIZE VOLUME TAB -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTabNormalize}">
          <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Standardize loudness across podcast episodes, music, or speech recordings"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Standard Presets -->
            <StackPanel Spacing="8">
              <TextBlock Text="Loudness Standards" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="pill" Classes.active="{Binding IsStandardPodcast}" Command="{Binding SetStandardLufsCommand}" CommandParameter="-16" Margin="0,0,6,6">
                  <TextBlock Text="-16 LUFS (Podcasts)" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsStandardStreaming}" Command="{Binding SetStandardLufsCommand}" CommandParameter="-14" Margin="0,0,6,6">
                  <TextBlock Text="-14 LUFS (Streaming)" />
                </Button>
                <Button Classes="pill" Classes.active="{Binding IsStandardBroadcast}" Command="{Binding SetStandardLufsCommand}" CommandParameter="-23" Margin="0,0,6,6">
                  <TextBlock Text="-23 LUFS (Broadcast)" />
                </Button>
              </WrapPanel>
            </StackPanel>

            <!-- Target Loudness Slider -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Integrated Loudness" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding TargetLufs, StringFormat='{}{0:0.0} LUFS'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="-30.0" Maximum="-10.0" Value="{Binding TargetLufs}" TickFrequency="0.5" />
            </StackPanel>

            <!-- True Peak Slider -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Maximum True Peak" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding TruePeak, StringFormat='{}{0:0.0} dBTP'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="-3.0" Maximum="-0.5" Value="{Binding TruePeak}" TickFrequency="0.1" />
            </StackPanel>

            <Button Classes="apply" Command="{Binding NormalizeAudioCommand}" IsEnabled="{Binding !IsProcessing}" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsProcessing}" />
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Volume}" IsVisible="{Binding !IsProcessing}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Normalize Audio Volume" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- 2. TRIM AUDIO TAB -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTabTrim}">
          <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Trim start and end points of audio recording" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- Sliders -->
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Start Position" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StartTimeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="0" Maximum="{Binding TotalDurationSeconds}" Value="{Binding StartTimeSeconds}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="End Position" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding EndTimeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider Minimum="0" Maximum="{Binding TotalDurationSeconds}" Value="{Binding EndTimeSeconds}" />
            </StackPanel>

            <!-- Duration Readout -->
            <Border Classes="glass-card" Padding="14">
              <DockPanel>
                <TextBlock Text="Trimmed Selection Duration:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TrimDurationText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <Button Classes="apply" Command="{Binding TrimAudioCommand}" IsEnabled="{Binding !IsProcessing}" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsProcessing}" />
                <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Check}" IsVisible="{Binding !IsProcessing}" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="Trim and Save Audio" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
