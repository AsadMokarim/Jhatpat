<!--
  Jhatpat "soft glass" look: frosted glass surfaces, subtle translucency, rounded corners,
  gentle depth, and springy press feedback.
  Colours that depend on light/dark live in ThemeDictionaries below; the accent colour, corner radii and
  the UI font are written at runtime by ThemeService (so users can customise them).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#FAF5ED" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF6EE" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2E7D6" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#269A6836" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1816" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E665E" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C73A39" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A5A" />
          <SolidColorBrush x:Key="WarningBrush" Color="#9A5B0C" />
          <SolidColorBrush x:Key="GlassPanelBrush" Color="#E4F7EFE1" />
          <SolidColorBrush x:Key="GlassHeaderBrush" Color="#DAF5ECE0" />
          <SolidColorBrush x:Key="GlassCardBrush" Color="#D2FBF6EC" />
          <SolidColorBrush x:Key="GlassBorderBrush" Color="#288A5E2E" />
          <SolidColorBrush x:Key="GlassBorderSpecularBrush" Color="#80FFFFFF" />
          <SolidColorBrush x:Key="GlassBackdropBrush" Color="#ECF8F1E4" />
          <SolidColorBrush x:Key="PillGroupBrush" Color="#15704018" />
          <SolidColorBrush x:Key="PillInactiveTextBrush" Color="#4A433A" />
          <SolidColorBrush x:Key="GlassInputBrush" Color="#F8FFFFFF" />
          <SolidColorBrush x:Key="GlassInputBorderBrush" Color="#34906535" />
          <BoxShadows x:Key="CardShadow">0 2 8 0 #0C000000, 0 8 24 0 #08000000</BoxShadows>
          <BoxShadows x:Key="GlassShadow">0 10 32 0 #18382010, 0 2 8 0 #0C201005</BoxShadows>
          <BoxShadows x:Key="GlassGlowShadow">0 6 24 0 #32FA4616, 0 1 6 0 #15000000</BoxShadows>
          <SolidColorBrush x:Key="CheckerboardTileBrush" Color="#0D000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#161311" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#221C18" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2D2520" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F2EB" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ADA498" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F09595" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#5DCAA5" />
          <SolidColorBrush x:Key="WarningBrush" Color="#EF9F27" />
          <SolidColorBrush x:Key="GlassPanelBrush" Color="#D0241E1A" />
          <SolidColorBrush x:Key="GlassHeaderBrush" Color="#C41A1613" />
          <SolidColorBrush x:Key="GlassCardBrush" Color="#B82B241F" />
          <SolidColorBrush x:Key="GlassBorderBrush" Color="#32FFFFFF" />
          <SolidColorBrush x:Key="GlassBorderSpecularBrush" Color="#50FFFFFF" />
          <SolidColorBrush x:Key="GlassBackdropBrush" Color="#E0181512" />
          <SolidColorBrush x:Key="PillGroupBrush" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="PillInactiveTextBrush" Color="#DDD5CA" />
          <SolidColorBrush x:Key="GlassInputBrush" Color="#E0221C18" />
          <SolidColorBrush x:Key="GlassInputBorderBrush" Color="#38FFFFFF" />
          <BoxShadows x:Key="CardShadow">0 3 12 0 #45000000, 0 10 30 0 #35000000</BoxShadows>
          <BoxShadows x:Key="GlassShadow">0 10 36 0 #60000000, 0 3 10 0 #40000000, 0 0 1 1 #20FFFFFF</BoxShadows>
          <BoxShadows x:Key="GlassGlowShadow">0 8 28 0 #44FA4616, 0 2 8 0 #25000000, 0 0 1 1 #30FFFFFF</BoxShadows>
          <SolidColorBrush x:Key="CheckerboardTileBrush" Color="#18FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Defaults; ThemeService overwrites these at startup. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#FA4616" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FA4616" />
      <SolidColorBrush x:Key="AccentFaintBrush" Color="#14FA4616" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#D83608" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <CornerRadius x:Key="SoftRadius">16</CornerRadius>
      <CornerRadius x:Key="SoftRadiusSmall">9</CornerRadius>
      <CornerRadius x:Key="SoftRadiusLarge">24</CornerRadius>
      <CornerRadius x:Key="SoftRadiusPill">20</CornerRadius>
      <FontFamily x:Key="AppFontFamily">Segoe UI, Malgun Gothic, Microsoft YaHei, sans-serif</FontFamily>

      <!-- Springy easing used by press/hover transitions ("말랑말랑"). -->
      <BackEaseOut x:Key="SoftEase" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ToggleSwitch's own On / Off labels are English only. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="{DynamicResource common.on}" />
    <Setter Property="OffContent" Value="{DynamicResource common.off}" />
  </Style>

  <!-- ───────── Windows & typography ───────── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ───────── Cards & Glass Surfaces ───────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Frosted glass card with subtle translucency and delicate border -->
  <Style Selector="Border.glass-card">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Glass overlay container for floating dialogs and tool windows -->
  <Style Selector="Border.glass-overlay">
    <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Glass panel for headers, toolbars, and grouped sections -->
  <Style Selector="Border.glass-panel">
    <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
  </Style>

  <!-- Specular rim highlight border -->
  <Style Selector="Border.specular-rim">
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderSpecularBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>

  <!-- Badge for engine status etc. -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>
  <Style Selector="Border.badge.ok">
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
  </Style>

  <!-- ───────── Buttons: soft corners, glass textures and a springy press ───────── -->
  <Style Selector="Button, ToggleButton, RepeatButton">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>

  <!-- Primary Accent Button (Warm Tangerine Gradient) -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.accent:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- Glass button: subtle frosted surface -->
  <Style Selector="Button.glass">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.glass:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.glass:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- Aspect and tool toggle buttons (crop, framing, resize overlays) -->
  <Style Selector="Button.aspect">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.aspect:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.aspect:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>
  <Style Selector="Button.aspect.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.aspect.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Small links at the bottom of the navigation (GitHub, Sponsor) -->
  <Style Selector="Button.navlink">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ProgressBar.soft">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
  </Style>

  <!-- ───────── Navigation list ───────── -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="translateX(4px)" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Generic rounded list items (profiles, presets) -->
  <Style Selector="ListBox.soft">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.soft ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.soft ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Circular top-left close button matching Tangerine modal design -->
  <Style Selector="Button.close-circle">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.close-circle:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>
  <Style Selector="Button.close-circle:pressed">
    <Setter Property="RenderTransform" Value="scale(0.92)" />
  </Style>

  <!-- Segmented pill selector container -->
  <Style Selector="Border.pill-group">
    <Setter Property="Background" Value="{DynamicResource PillGroupBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- Segmented pill button -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PillInactiveTextBrush}" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
  </Style>
  <Style Selector="Button.pill.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.pill.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
  </Style>

  <!-- Segmented pill divider line -->
  <Style Selector="Rectangle.pill-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Fill" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0" />
  </Style>

  <!-- Primary Tangerine Apply action button -->
  <Style Selector="Button.apply">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.apply:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <Style Selector="Button.apply:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- Secondary Reset glass action button -->
  <Style Selector="Button.reset">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.reset:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.reset:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- Glass Numeric and Text Inputs -->
  <Style Selector="TextBox.glass">
    <Setter Property="Background" Value="{DynamicResource GlassInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ───────── Donut control colours ───────── -->
  <Style Selector="c|DonutMenu">
    <Setter Property="SliceBrush" Value="{DynamicResource GlassCardBrush}" />
    <Setter Property="SliceBorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="CenterBrush" Value="{DynamicResource GlassPanelBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="OnAccentBrush" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SecondaryForeground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="DangerBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="SuccessBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- ───────── Page content fade-in (keyframes can't animate RenderTransform, so Margin slides) ───────── -->
  <Style Selector="ContentControl.page > :is(Control)">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Margin" Value="0,10,0,-10" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Margin" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ───────── Reduced motion: remove every transition and animation above ───────── -->
  <Style Selector="Window.reduced-motion :is(Button), Window.reduced-motion :is(ToggleButton), Window.reduced-motion Border.chip, Window.reduced-motion ListBoxItem">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduced-motion Button:pressed, Window.reduced-motion ToggleButton:pressed, Window.reduced-motion Border.chip:pointerover, Window.reduced-motion ListBox.nav ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.reduced-motion ContentControl.page > :is(Control)">
    <Style.Animations>
      <Animation Duration="0:0:0.001" FillMode="Forward">
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
